{
  "manifest_version": 3,
  "name": "Quick Time Log & Edit for Everhour on Trello",
  "short_name": "Quick Time Log",
  "version": "0.1.0",
  "description": "See your Everhour week on Trello in a side panel, and log, fix or delete entries without hunting through filters.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://trello.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Quick Time Log & Edit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "sidebar_action": {
    "default_panel": "src/sidepanel/index.html",
    "default_title": "Quick Time Log & Edit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.everhour.com/trello-powerup/*"
      ],
      "js": [
        "src/content/everhour-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.everhour.com/trello-powerup/*"
      ],
      "js": [
        "src/content/everhour-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-log-everhour@qin-yu.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "authenticationInfo",
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  }
}
